# Trained policies. Regenerated by scripts/run_sac.py; the one that ships is
# committed as firmware/main/sac_actor_weights.h, which is the artefact that
# has to be reproducible.
/data/actors/

# Dataset archive: large, and redistribution may not be permitted.
# Two subtleties here, both of which bite silently:
#   - the leading slash anchors to the repo root; a bare "data/" would also
#     match src/evpil/data/ and exclude the loader and split modules;
#   - "/data/*" excludes the CONTENTS rather than the directory, because git
#     cannot re-include a file whose parent directory is itself excluded.
/data/*
!/data/splits.json
!/data/i3_params.json

firmware/build/
firmware/host_test/test_protocol
firmware/host_test/test_control
firmware/host_test/test_actor

# Generated by idf.py from sdkconfig.defaults; not a source file.
firmware/sdkconfig
firmware/sdkconfig.old

# A second, byte-identical extraction of the i3 archive that appeared at the
# repo root. Verified identical to data/raw/i3 (all 70 CSVs, readme.txt and
# readin.m match by MD5) on 2026-09-02, so it carries nothing the tracked tree
# lacks. Ignored rather than deleted: it is 190 MB of a dataset whose
# redistribution terms are not ours to assume, and the /data/* rule above does
# not reach the repo root.
/Measurement Data/
